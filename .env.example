# API (local). En Render se inyectan solas o se configuran en el dashboard.
CORS_ORIGINS=
# Vacío = usar el default (https://*.onrender.com). Pon "" para desactivar el regex.
# CORS_ORIGIN_REGEX=https://.*\.onrender\.com

# Web (solo build). En Cloudflare Pages se deja vacío (same-origin `/api`).
# En local el proxy de Vite apunta a Wrangler (http://127.0.0.1:8788).
# VITE_API_URL=
